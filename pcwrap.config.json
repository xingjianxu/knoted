{
  "name": "knoted",
  "port": 15600,
  "configFile": "process-compose.yaml",
  "logFile": "/data/knoted-dev/service/logs/process-compose.log",
  "keepProject": true,
  "env": {
    "mode": "app",
    "watch": [
      "KNOTED_INSTANCE_ROOT",
      "KNOTED_RUNTIME_ROOT",
      "KNOTED_API_PORT",
      "KNOTED_HTTPS_PORT",
      "KNOTED_HTTPS_DOMAIN",
      "DATABASE_URL",
      "KNOTED_SEARCH_ENABLED",
      "KNOTED_SEARCH_CREDENTIAL_FILE",
      "KNOTED_OFFICE_ORIGIN",
      "KNOTED_OFFICE_JWT_SECRET_FILE"
    ]
  }
}
