[server]
bind = "127.0.0.1:@API_PORT@"

[database]
url = "@DATABASE_URL@"

[auth]
rp_id = "@DOMAIN@"
origin = "https://@DOMAIN@:@HTTPS_PORT@"

[logging]
level = "@LOG_LEVEL@"
format = "json"

[assets]
root = "@ASSETS_ROOT@"

[files]
enabled = true
root = "/data/vaultsyncd-dev/dev-server/vaults/knoted-test"
staging_root = "@STAGING_ROOT@"
debounce_seconds = 2
rescan_seconds = 600

[intelligence]
base_url = "http://127.0.0.1:@INTELLIGENCE_PORT@"
