{
  "name": "knoted",
  "private": true,
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "api:verify": "pnpm api:generate && test -z \"$(git status --porcelain -- packages/api-client/src/generated)\"",
    "api:check": "node api/examples/check.mjs",
    "api:generate": "pnpm --filter @knoted/api-client run generate",
    "pc": "pcwrap",
    "deploy:dev": "bash tools/dev/deploy-dev.sh",
    "test:pc": "node --test tests/pc/"
  },
  "devDependencies": {
    "@bixlab/pcwrap": "0.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "yaml": "2.9.1"
  }
}
